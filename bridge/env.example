# Copy to bridge/.env and fill in.
# bridge/.env is gitignored — never commit real keys.

# xAI Realtime API key. Must begin with `xai-`.
# Create one at https://console.x.ai/ -> API Keys, with Voice enabled.
XAI_API_KEY=xai-REPLACE_ME

# Shared device credential. Generate with: openssl rand -hex 32
# Put the same value in firmware/pocket/main/secrets.h.
POCKET_DEVICE_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# Device mode listens on the LAN. Set to a specific interface address to narrow exposure.
POCKET_BIND_HOST=0.0.0.0

# Private transcripts/tool results and raw mic capture are disabled by default.
POCKET_DEBUG_PRIVATE=0
POCKET_CAPTURE_AUDIO=0
# POCKET_CAPTURE_PATH=/tmp/pocket_rx.pcm
